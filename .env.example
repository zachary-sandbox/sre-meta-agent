# ==========================================
# [SECTION] 1. Common LLM Settings
# ==========================================
# This section applies to ALL providers.
# Change these variables to switch your active model.

# Available providers: openai, anthropic, deepseek, ollama
LLM_PROVIDER=anthropic
LLM_MODEL_NAME=claude-3-haiku-20240307
LLM_TEMPERATURE=0


# ==========================================
# [SECTION] 2. LLM Provider Credentials
# ==========================================
# Fill in the API key and base URL for the provider you selected above.
# Leave the others commented out.

# [Provider] Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_API_BASE=https://api.your-proxy.com/v1

# [Provider] OpenAI
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_API_BASE=https://api.your-proxy.com/v1

# [Provider] DeepSeek
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_API_BASE=https://api.deepseek.com

# [Provider] Ollama (Local)
# OLLAMA_BASE_URL=http://localhost:11434


# ==========================================
# [SECTION] 3. Application Infrastructure
# ==========================================
# The URL the Streamlit frontend uses to reach the FastAPI backend.
# Use http://backend:8000 if running inside Docker Compose.
BACKEND_API_URL=http://127.0.0.1:8000

# Absolute path to your kubeconfig file.
# Windows example: C:/Users/YourUsername/.kube/config
# Mac/Linux example: /home/user/.kube/config
KUBECONFIG_PATH=C:/Users/YourUsername/.kube/config


# ==========================================
# [SECTION] 4. Observability (LangSmith)
# ==========================================
# Set to "true" to enable tracing. "false" to disable.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key
LANGCHAIN_PROJECT=sre-meta-agent