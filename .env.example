# ==========================================
# LLM Configuration
# ==========================================
# Options: openai, anthropic, deepseek, ollama
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4-turbo
LLM_TEMPERATURE=0


# API Keys (Fill in the one corresponding to your LLM_PROVIDER)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-your-anthropic-key
DEEPSEEK_API_KEY=sk-your-deepseek-key

# If using a proxy or OpenAI-compatible endpoint (e.g., Qwen, vLLM)
# OPENAI_API_BASE=https://api.your-proxy.com/v1

# If using Ollama locally, uncomment and set this:
# LLM_PROVIDER=ollama
# LLM_MODEL_NAME=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434

# Specify the path to your kubeconfig file. 
# Windows example: C:/Users/KUN/.kube/config
# Mac/Linux example: /home/user/.kube/config
KUBECONFIG_PATH=C:/Users/KUN/.kube/dashboard-admin.kubeconfig

# ==========================================
# Backend Configuration
# ==========================================
BACKEND_API_URL=http://127.0.0.1:8000

# ==========================================
# Observability (LangSmith)
# ==========================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key
LANGCHAIN_PROJECT=sre-meta-agent